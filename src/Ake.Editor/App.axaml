<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dock="using:Dock.Avalonia.Themes.Fluent"
             xmlns:dockc="using:Dock.Avalonia.Controls"
             x:Class="Ake.Editor.App"
             RequestedThemeVariant="Light">
    <!-- Editör teması (ADR-0023, ADR-0045): Inter, sıkı yoğunluk, krem zemin, koyu mürekkep metin, tek mavi vurgu. Çizim kâğıdı beyaz kalır. -->
    <Application.Resources>
        <FontFamily x:Key="UiFont">fonts:Inter#Inter</FontFamily>
        <SolidColorBrush x:Key="WindowBrush" Color="#F2EDE1" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FBF8F1" />
        <SolidColorBrush x:Key="HeaderBrush" Color="#E8E0CC" />
        <SolidColorBrush x:Key="RibbonBrush" Color="#F7F2E6" />
        <SolidColorBrush x:Key="RibbonBodyBrush" Color="#FBF8F1" />
        <SolidColorBrush x:Key="LineBrush" Color="#D6CDB8" />
        <SolidColorBrush x:Key="MutedBrush" Color="#6B6455" />
        <SolidColorBrush x:Key="InkBrush" Color="#2B2619" />
        <!-- BrandBrush: seçili sekme ve basılı düğme dolgusu (açık mavi). -->
        <SolidColorBrush x:Key="BrandBrush" Color="#DCEAFB" />
        <SolidColorBrush x:Key="AccentBrush" Color="#1F6FD8" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#DCEAFB" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundChecked" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPointerOver" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CheckBoxCheckGlyphForegroundCheckedPressed" Color="#FFFFFF" />
        <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF" />
        <!-- Fluent vurgu ailesi mavi: seçili öğeler, odak, işaretli kutular. -->
        <Color x:Key="SystemAccentColor">#1F6FD8</Color>
        <Color x:Key="SystemAccentColorLight1">#4C8FE3</Color>
        <Color x:Key="SystemAccentColorLight2">#8DB8EE</Color>
        <Color x:Key="SystemAccentColorLight3">#BBD5F5</Color>
        <Color x:Key="SystemAccentColorDark1">#1A5EB8</Color>
        <Color x:Key="SystemAccentColorDark2">#154C96</Color>
        <Color x:Key="SystemAccentColorDark3">#103A73</Color>
        <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#1F6FD8" />
        <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#2E7BE0" />
        <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#4C8FE3" />
        <SolidColorBrush x:Key="SystemControlHighlightAccentBrush" Color="#1F6FD8" />
        <SolidColorBrush x:Key="SystemControlBackgroundAccentBrush" Color="#1F6FD8" />
        <SolidColorBrush x:Key="SystemControlForegroundAccentBrush" Color="#1A5EB8" />
        <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#1A5EB8" />
        <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#1A5EB8" />
        <!-- Açılır öğeler krem: sağ tık ve açılır menüler, açılır listeler, ipuçları, balonlar. -->
        <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FBF8F1" />
        <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#D6CDB8" />
        <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPointerOver" Color="#EFE8D6" />
        <SolidColorBrush x:Key="MenuFlyoutItemBackgroundPressed" Color="#E3D9C0" />
        <SolidColorBrush x:Key="MenuFlyoutItemBackgroundSubMenuOpened" Color="#EFE8D6" />
        <SolidColorBrush x:Key="MenuFlyoutItemForeground" Color="#2B2619" />
        <SolidColorBrush x:Key="MenuFlyoutItemForegroundPointerOver" Color="#2B2619" />
        <SolidColorBrush x:Key="MenuFlyoutItemForegroundPressed" Color="#2B2619" />
        <SolidColorBrush x:Key="MenuFlyoutItemForegroundDisabled" Color="#9A927F" />
        <SolidColorBrush x:Key="MenuFlyoutSeparatorBackground" Color="#D6CDB8" />
        <SolidColorBrush x:Key="MenuItemBackgroundPointerOver" Color="#EFE8D6" />
        <SolidColorBrush x:Key="MenuItemBackgroundPressed" Color="#E3D9C0" />
        <SolidColorBrush x:Key="FlyoutPresenterBackground" Color="#FBF8F1" />
        <SolidColorBrush x:Key="FlyoutBorderThemeBrush" Color="#D6CDB8" />
        <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FBF8F1" />
        <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#D6CDB8" />
        <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#EFE8D6" />
        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#DCEAFB" />
        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#CCDFF8" />
        <SolidColorBrush x:Key="ComboBoxItemBackgroundPressed" Color="#E3D9C0" />
        <SolidColorBrush x:Key="ToolTipBackground" Color="#FBF8F1" />
        <SolidColorBrush x:Key="ToolTipBorderBrush" Color="#D6CDB8" />
        <SolidColorBrush x:Key="ToolTipForeground" Color="#2B2619" />
        <!-- Dock (sayfa sekmeleri, paneller) vurgu renkleri. -->
        <SolidColorBrush x:Key="DockApplicationAccentBrushLow" Color="#E8E0CC" />
        <SolidColorBrush x:Key="DockApplicationAccentBrushMed" Color="#BBD5F5" />
        <SolidColorBrush x:Key="DockApplicationAccentBrushHigh" Color="#1F6FD8" />
        <SolidColorBrush x:Key="DockApplicationAccentForegroundBrush" Color="#FFFFFF" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme DensityStyle="Compact">
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#1F6FD8" RegionColor="#FBF8F1" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <dock:DockFluentTheme />

        <Style Selector="Window">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="{StaticResource WindowBrush}" />
            <Setter Property="Icon" Value="avares://Ake.Editor/Assets/logo.ico" />
        </Style>

        <!-- Dock: seçili sayfa sekmesi açık mavi dolgu ve mavi alt çizgi; araç sekmeleri mavi metin -->
        <Style Selector="dockc|DocumentTabStripItem:selected, dockc|DocumentTabStripItem:active:selected">
            <Setter Property="Background" Value="{StaticResource BrandBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>
        <Style Selector="dockc|DocumentTabStripItem:selected /template/ Border#PART_TabBody, dockc|DocumentTabStripItem:active:selected /template/ Border#PART_TabBody">
            <Setter Property="Background" Value="{StaticResource BrandBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="dockc|DocumentTabStrip">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="dockc|ToolTabStripItem:selected, dockc|ToolTabStripItem:active:selected">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>

        <!-- Komut şeridi -->
        <Style Selector=":is(Border).ribbon">
            <Setter Property="Background" Value="{StaticResource RibbonBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="Button.ribbon-file">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="16,5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.ribbon-tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="14,5" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.ribbon-tab.selected">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.ribbon-body">
            <Setter Property="Background" Value="{StaticResource RibbonBodyBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Height" Value="92" />
            <Setter Property="Padding" Value="4,4,4,0" />
        </Style>
        <Style Selector="Border.ribbon-group">
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="Padding" Value="4,0,6,0" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style Selector="TextBlock.ribbon-group-label">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2,0,3" />
        </Style>
        <Style Selector=":is(Button).ribbon-large, :is(Button).ribbon-small, :is(Button).ribbon-quick">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector=":is(Button).ribbon-large">
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="MinWidth" Value="66" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
        </Style>
        <Style Selector=":is(Button).ribbon-small">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector=":is(Button).ribbon-quick">
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style Selector=":is(Button).ribbon-large:disabled /template/ ContentPresenter#PART_ContentPresenter, :is(Button).ribbon-small:disabled /template/ ContentPresenter#PART_ContentPresenter, :is(Button).ribbon-quick:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector=":is(Button).ribbon-large:disabled, :is(Button).ribbon-small:disabled, :is(Button).ribbon-quick:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource BrandBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        </Style>

        <!-- Paneller -->
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.panel-header">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style Selector="Border.panel-header TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TabControl.nav">
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="TabControl.nav TabItem">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="7,2" />
        </Style>
        <Style Selector="ListBox.nav, TreeView">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="MinHeight" Value="22" />
        </Style>
        <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
        </Style>

        <!-- Durum çubuğu -->
        <Style Selector="Border.status">
            <Setter Property="Background" Value="{StaticResource HeaderBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>
        <Style Selector="Border.status-cell">
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="Padding" Value="10,3" />
        </Style>
        <Style Selector="Border.status-cell TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>

        <!-- Sayfa sekmesi -->
        <Style Selector="Border.doc-tab">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="6,4,0,0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </Application.Styles>
</Application>
