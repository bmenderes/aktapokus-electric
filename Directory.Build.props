<Project>

  <PropertyGroup>
    <!--
      ADR-0001 hedefi .NET 10; makinede SDK 10 olmadigi icin varsayilan gecici olarak net9.0.
      SDK 10 kurulunca burayi net10.0 yapin ya da AkeTargetFramework ortam degiskenini verin.
    -->
    <AkeTargetFramework Condition="'$(AkeTargetFramework)' == '' and $([System.Environment]::Version.Major) &lt; 10">net9.0</AkeTargetFramework>
    <AkeTargetFramework Condition="'$(AkeTargetFramework)' == ''">net10.0</AkeTargetFramework>
    <TargetFramework>$(AkeTargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
